<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ChromeDock" xmlns:repo="using:ChromeDock.Repositories"
        x:CompileBindings="False" x:Class="ChromeDock.MainWindow" Title=""
        Width="1040" Height="680" MinWidth="820" MinHeight="540" WindowStartupLocation="CenterScreen"
        Background="#F6F8FB"
        FontFamily="avares://ChromeDock/Assets/Fonts/SarasaUiSC-Regular.ttf#Sarasa UI SC">
  <Grid RowDefinitions="Auto,*,Auto" Margin="32,24,32,20">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="/Assets/Logo/LOGO_L.png" Width="34" Height="34" Stretch="Uniform"/><TextBlock x:Name="ProductTitle" Text="ChromeDock 指纹浏览器" FontSize="26" FontWeight="Bold" Foreground="#182230" VerticalAlignment="Center"/></StackPanel>
      <Button Grid.Column="1" Content="＋ 新建环境" Classes="primary" FontSize="12" FontWeight="Normal" Height="44" VerticalAlignment="Center" Click="NewEnvironmentButton_Click"/>
    </Grid>
    <Border Grid.Row="1" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10">
      <Grid RowDefinitions="62,48,*,58">
        <Grid ColumnDefinitions="260,*,140" Margin="20,13">
          <TextBox x:Name="SearchBox" PlaceholderText="搜索环境名称或 ID" Height="36" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
          <ComboBox x:Name="StatusFilterBox" Grid.Column="2" Height="36" DisplayMemberBinding="{CompiledBinding Label, DataType={x:Type repo:SelectionOption}}" SelectedValueBinding="{CompiledBinding Value, DataType={x:Type repo:SelectionOption}}" SelectionChanged="StatusFilterBox_SelectionChanged"/>
        </Grid>
        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="0,1,0,1">
          <Grid ColumnDefinitions="1.3*,2.6*,1.2*,2*,2.3*,1.9*" Margin="22,0" VerticalAlignment="Center">
            <TextBlock Text="ID" Classes="heading"/><TextBlock Grid.Column="1" Text="名称" Classes="heading"/><TextBlock Grid.Column="2" Text="状态" Classes="heading"/><TextBlock Grid.Column="3" Text="网络状态" Classes="heading"/><TextBlock Grid.Column="4" Text="代理" Classes="heading"/><TextBlock Grid.Column="5" Text="操作" Classes="heading"/>
          </Grid>
        </Border>
        <Grid Grid.Row="2">
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◉" FontSize="38" Foreground="#B7C3D7" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyStateText" Text="暂无浏览器环境" FontSize="17" FontWeight="Bold" Foreground="#344054" HorizontalAlignment="Center" Margin="0,12,0,0"/><TextBlock x:Name="EmptyStateHint" Text="创建环境后，可在这里启动和管理浏览器" Foreground="#667085" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="EnvironmentRows" IsVisible="False"><ItemsControl.ItemTemplate><DataTemplate DataType="local:EnvironmentListItem" x:DataType="local:EnvironmentListItem" x:CompileBindings="True">
            <Border BorderBrush="#EAECF0" BorderThickness="0,0,0,1" Padding="22,15">
              <Grid ColumnDefinitions="1.3*,2.6*,1.2*,2*,2.3*,1.9*">
                <SelectableTextBlock Text="{Binding FingerprintSeed}" FontSize="12" Foreground="#475467" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="7"><Grid Width="14" Height="14"><Ellipse Width="8" Height="8" Fill="#12B76A" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsRunning}"/><Path Data="M 7,1 A 6,6 0 1 1 1,7" Stroke="#315CF5" StrokeThickness="2" Width="14" Height="14" RenderTransformOrigin="50%,50%" IsVisible="{Binding IsOpening}"><Path.RenderTransform><RotateTransform Angle="{Binding SpinnerAngle}"/></Path.RenderTransform></Path></Grid><SelectableTextBlock Text="{Binding Name}" FontSize="12" Foreground="#182230" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><SelectableTextBlock Text="{Binding Status}" FontSize="12" Foreground="#475467"/><StackPanel Orientation="Horizontal" Spacing="2"><TextBlock Text="本地" FontSize="10" Foreground="{Binding LocalColor}" ToolTip.Tip="{Binding LocalTip}"/><TextBlock Text="|" FontSize="10" Foreground="#98A2B3"/><TextBlock Text="代理" FontSize="10" Foreground="{Binding RemoteColor}" ToolTip.Tip="{Binding RemoteTip}"/><TextBlock Text="|" FontSize="10" Foreground="#98A2B3"/><TextBlock Text="调试" FontSize="10" Foreground="{Binding DebugColor}" ToolTip.Tip="{Binding DebugTip}"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{Binding NetworkColor}" Margin="0,0,8,0" VerticalAlignment="Center"/><StackPanel><Button Content="{Binding Ip}" Classes="link" FontSize="12" CommandParameter="{Binding}" Click="IpButton_Click" ToolTip.Tip="{Binding NetworkError}"/><Grid Height="17"><SelectableTextBlock Text="{Binding Location}" FontSize="10" Foreground="#667085" IsVisible="{Binding !IsChecking}"/><Path Data="M 7,1 A 6,6 0 1 1 1,7" Stroke="#315CF5" StrokeThickness="2" Width="14" Height="14" HorizontalAlignment="Left" RenderTransformOrigin="50%,50%" IsVisible="{Binding IsChecking}"><Path.RenderTransform><RotateTransform Angle="{Binding SpinnerAngle}"/></Path.RenderTransform></Path></Grid></StackPanel></StackPanel>
                <SelectableTextBlock Grid.Column="4" Text="{Binding Proxy}" FontSize="12" Foreground="#475467" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"><Button Content="{Binding ActionText}" Classes="primary" FontSize="12" FontWeight="Normal" Width="52" Height="30" Padding="0" Click="OpenCloseButton_Click"/><Button Content="修改" Classes="secondary" FontSize="12" FontWeight="Normal" Width="52" Height="30" Padding="0" Click="ModifyButton_Click"/></StackPanel>
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="20,0" VerticalAlignment="Center">
          <TextBlock x:Name="RangeText" Text="共 0 个环境 · 显示 0–0 个" Foreground="#667085" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"><TextBlock Text="每页" Foreground="#667085" VerticalAlignment="Center" Margin="0,0,2,0"/><ComboBox x:Name="PageSizeBox" Width="74" Height="34" DisplayMemberBinding="{CompiledBinding Label, DataType={x:Type repo:SelectionOption}}" SelectedValueBinding="{CompiledBinding Value, DataType={x:Type repo:SelectionOption}}" SelectionChanged="PageSizeBox_SelectionChanged"/><Button x:Name="PreviousButton" Content="‹" Classes="secondary" Width="34" Height="34" Margin="10,0,0,0" Click="PreviousButton_Click"/><ComboBox x:Name="PageBox" Width="70" Height="34" SelectionChanged="PageBox_SelectionChanged"/><TextBlock x:Name="PageCountText" Text="/ 1 页" Foreground="#667085" VerticalAlignment="Center"/><Button x:Name="NextButton" Content="›" Classes="secondary" Width="34" Height="34" Click="NextButton_Click"/></StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="2,16,2,0"><Button x:Name="SettingsButton" Content="⚙" Classes="secondary" Width="34" Height="34" FontFamily="Segoe UI Symbol" FontSize="20" Padding="0" ToolTip.Tip="设置" Click="SettingsButton_Click"/><TextBlock Grid.Column="1" Text="用户数据目录可在设置中修改" Foreground="#667085" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      <Popup x:Name="SettingsPopup" Placement="TopEdgeAlignedLeft" VerticalOffset="-8" IsLightDismissEnabled="True"><Border Width="400" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="设置" FontSize="17" FontWeight="Bold" Foreground="#182230"/><TextBlock Text="IPinfo API Token" Foreground="#344054" Margin="0,16,0,8"/><TextBox x:Name="TokenBox" Height="36"/><TextBlock Text="免费接口失败时使用；留空清除。保存值仅当前 Windows 用户可解密。" Foreground="#667085" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="用户数据目录" Foreground="#344054" Margin="0,16,0,8"/><TextBox x:Name="UserDataDirectoryBox" Height="36"/><TextBlock Text="填写完整路径；保存时创建目录。" Foreground="#667085" FontSize="12" Margin="0,8,0,14"/><Button Content="保存" Classes="primary" Width="76" Height="34" HorizontalAlignment="Right" Click="SaveSettingsButton_Click"/></StackPanel></Border></Popup>
    </Grid>
    <Popup x:Name="ActionPopup" IsLightDismissEnabled="True" Placement="BottomEdgeAlignedLeft"><Border HorizontalAlignment="Left" Padding="6" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10"><StackPanel><Button Content="编辑" Classes="menu" Click="EditEnvironmentMenuItem_Click"/><Button Content="复制" Classes="menu" Click="CopyEnvironmentMenuItem_Click"/><Border Height="1" Background="#EAECF0" Margin="6,5"/><Button Content="删除" Classes="menu danger" Click="DeleteEnvironmentMenuItem_Click"/></StackPanel></Border></Popup>
  </Grid>
</Window>



