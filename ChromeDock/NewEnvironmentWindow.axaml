<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:repo="using:ChromeDock.Repositories" x:CompileBindings="False" x:Class="ChromeDock.NewEnvironmentWindow"
        Title="新建环境" Width="680" Height="760" MinWidth="580" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="#F6F8FB" FontFamily="avares://ChromeDock/Assets/Fonts/SarasaUiSC-Regular.ttf#Sarasa UI SC" FontSize="12">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Margin="0,0,0,18"><TextBlock x:Name="EditorTitle" Text="新建浏览器环境" FontSize="22" FontWeight="Bold" Foreground="#182230"/><TextBlock Text="为这个环境设置独立的浏览器数据和启动参数" Foreground="#667085" Margin="0,5,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid ColumnDefinitions="88,*,18,64,*" RowDefinitions="46,32,46,46,46,32,46,46,Auto" Margin="24,22">
        <TextBlock Grid.Row="0" Text="环境名字" Classes="field-label"/><TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Classes="field"/>
        <Border Grid.Row="1" Grid.ColumnSpan="5" Height="1" Background="#EAECF0" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="2" Text="代理类型" Classes="field-label"/><ComboBox x:Name="ProxyTypeBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Classes="field" DisplayMemberBinding="{CompiledBinding Label, DataType={x:Type repo:SelectionOption}}" SelectedValueBinding="{CompiledBinding Value, DataType={x:Type repo:SelectionOption}}"/>
        <TextBlock Grid.Row="3" Text="地址" Classes="field-label"/><TextBox x:Name="ProxyAddressBox" Grid.Row="3" Grid.Column="1" Classes="field"/><TextBlock Grid.Row="3" Grid.Column="3" Text="端口" Classes="field-label"/><TextBox x:Name="ProxyPortBox" Grid.Row="3" Grid.Column="4" Classes="field"/>
        <TextBlock Grid.Row="4" Text="用户名" Classes="field-label"/><TextBox x:Name="ProxyUsernameBox" Grid.Row="4" Grid.Column="1" Classes="field"/><TextBlock Grid.Row="4" Grid.Column="3" Text="密码" Classes="field-label"/><TextBox x:Name="ProxyPasswordBox" Grid.Row="4" Grid.Column="4" Classes="field"/>
        <Border Grid.Row="5" Grid.ColumnSpan="5" Height="1" Background="#EAECF0" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="6" Text="语言" Classes="field-label"/>
        <Grid Grid.Row="6" Grid.Column="1"><Button x:Name="LanguageButton" Classes="secondary" Height="30" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="LanguageButton_Click"><Grid ColumnDefinitions="*,Auto" Margin="6,0"><TextBlock x:Name="LanguageSelectionText" Text="跟随系统" Foreground="#344054" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="⌄" Foreground="#98A2B3"/></Grid></Button><Popup x:Name="LanguagePopup" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True" Opened="LanguagePopup_Opened"><Border Width="300" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="6"><StackPanel><TextBlock Text="搜索语言代码" Foreground="#667085" FontSize="12" Margin="4,0,0,6"/><TextBox x:Name="LanguageSearchBox" Classes="field" TextChanged="LanguageSearchBox_TextChanged"/><ListBox x:Name="LanguageList" Height="260" Margin="0,8,0,0" BorderThickness="0" SelectionMode="Multiple,Toggle" ScrollViewer.VerticalScrollBarVisibility="Visible" SelectionChanged="LanguageList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate x:DataType="repo:SelectionOption" x:CompileBindings="True"><TextBlock Text="{Binding Value}"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></Popup></Grid>
        <TextBlock Grid.Row="6" Grid.Column="3" Text="时区" Classes="field-label"/>
        <Grid Grid.Row="6" Grid.Column="4"><Button x:Name="TimezoneButton" Classes="secondary" Height="30" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="TimezoneButton_Click"><Grid ColumnDefinitions="*,Auto" Margin="6,0"><TextBlock x:Name="TimezoneSelectionText" Text="跟随系统" Foreground="#344054" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="⌄" Foreground="#98A2B3"/></Grid></Button><Popup x:Name="TimezonePopup" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True" Opened="TimezonePopup_Opened"><Border Width="260" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="6"><StackPanel><TextBlock Text="搜索时区" Foreground="#667085" FontSize="12" Margin="4,0,0,6"/><TextBox x:Name="TimezoneSearchBox" Classes="field" TextChanged="TimezoneSearchBox_TextChanged"/><ListBox x:Name="TimezoneList" Height="260" Margin="0,8,0,0" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Visible" SelectionChanged="TimezoneList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate x:DataType="repo:SelectionOption" x:CompileBindings="True"><TextBlock Text="{Binding Value}"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></Popup></Grid>
        <TextBlock Grid.Row="7" Text="系统" Classes="field-label"/><ComboBox x:Name="PlatformBox" Grid.Row="7" Grid.Column="1" Classes="field" DisplayMemberBinding="{CompiledBinding Label, DataType={x:Type repo:SelectionOption}}" SelectedValueBinding="{CompiledBinding Value, DataType={x:Type repo:SelectionOption}}"/><TextBlock Grid.Row="7" Grid.Column="3" Text="浏览器" Classes="field-label"/><ComboBox x:Name="BrowserBox" Grid.Row="7" Grid.Column="4" Classes="field" DisplayMemberBinding="{CompiledBinding Label, DataType={x:Type repo:SelectionOption}}" SelectedValueBinding="{CompiledBinding Value, DataType={x:Type repo:SelectionOption}}"/>
        <Border Grid.Row="8" Grid.ColumnSpan="5" Background="#F9FAFB" CornerRadius="8" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock Text="用户数据" FontWeight="Bold" Foreground="#344054"/><TextBlock Text="用户数据根目录在主界面设置中指定" Foreground="#667085" Margin="0,5,0,0"/></StackPanel></Border>
      </Grid></ScrollViewer>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,18,0,0"><Button Content="取消" Classes="secondary" Width="88" Height="40" Click="CancelButton_Click"/><Button x:Name="SaveAndStartButton" Content="保存并启动" Classes="primary" Height="40" Click="SaveButton_Click"/><Button Content="保存" Classes="primary" Width="88" Height="40" Click="SaveButton_Click"/></StackPanel>
  </Grid>
</Window>




