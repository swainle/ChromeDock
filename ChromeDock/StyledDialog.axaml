<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ChromeDock.StyledDialog"
        Width="440" Height="210" CanResize="False" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F6F8FB" FontFamily="avares://ChromeDock/Assets/Fonts/SarasaUiSC-Regular.ttf#Sarasa UI SC">
  <Border Margin="16" Padding="24" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="32" Height="32" CornerRadius="16" Background="#FEF3F2" Margin="0,0,12,0"><TextBlock Text="!" FontWeight="Bold" FontSize="17" Foreground="#D92D20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" Foreground="#182230" VerticalAlignment="Center"/></StackPanel>
      <TextBox x:Name="MessageText" Grid.Row="1" Margin="44,14,0,24" Padding="0" BorderThickness="0" Background="Transparent" Foreground="#475467" FontSize="13" TextWrapping="Wrap" IsReadOnly="True"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button x:Name="CancelButton" Content="取消" Classes="secondary" Width="78" Height="36" IsVisible="False" Click="CancelButton_Click"/><Button x:Name="ConfirmButton" Content="确定" Classes="primary" Width="78" Height="36" Click="ConfirmButton_Click"/></StackPanel>
    </Grid>
  </Border>
</Window>
