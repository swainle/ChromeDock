<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChromeDock.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#315CF5"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#344054"/>
      <Setter Property="BorderBrush" Value="#D0D5DD"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#F9FAFB"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#315CF5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.menu">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#98A2B3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.menu:pointerover">
      <Setter Property="Background" Value="#F2F4F7"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="#D92D20"/>
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="Foreground" Value="#475467"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="#344054"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox.field">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.secondary:disabled">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#B7C3D0"/>
      <Setter Property="BorderBrush" Value="#D0D5DD"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ComboBox:disabled">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#344054"/>
      <Setter Property="BorderBrush" Value="#D0D5DD"/>
    </Style>
    <Style Selector="TextBox:disabled">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#98A2B3"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#344054"/>
      <Setter Property="BorderBrush" Value="#D0D5DD"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Foreground" Value="#344054"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Margin="2,1">
            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="#E9F2FF"/>
      <Setter Property="BorderBrush" Value="#8FC5F3"/>
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="#E9F2FF"/>
      <Setter Property="BorderBrush" Value="#8FC5F3"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Foreground" Value="#344054"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Margin="2,1">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="#F2F4F7"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#E9F2FF"/>
      <Setter Property="BorderBrush" Value="#8FC5F3"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="#D8E5FF"/>
      <Setter Property="SelectionForegroundBrush" Value="#182230"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D0D5DD"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
  </Application.Styles>
</Application>
